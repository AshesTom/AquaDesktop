# AquaDesktop: macOS Terminal's default window for Konsole, the "Basic"
# profile: 80 x 24, a steady grey block cursor, "user — process" titles.
# The font is the system's fixed font. Konsole picks the light or dark one
# with the system's appearance ([LightDarkTheme] in konsolerc).
# SPDX-License-Identifier: GPL-3.0-or-later

[Appearance]
ColorScheme=MacTahoeLiquidKdeDark

[Cursor Options]
CursorShape=0
CustomCursorColor=157,157,157
UseCustomCursorColor=true

[General]
LocalTabTitleFormat=%u — %n
Name=AquaDesktop Dark
Parent=FALLBACK/
TerminalColumns=80
TerminalRows=24

[Terminal Features]
BlinkingCursorEnabled=false
