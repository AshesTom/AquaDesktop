diff --color -ruN base/Kvantum-1.1.8/Kvantum/style/tahoe_menu.h b/Kvantum-1.1.8/Kvantum/style/tahoe_menu.h
--- a/Kvantum/style/tahoe_menu.h	1970-01-01 01:00:00.000000000 +0100
+++ b/Kvantum/style/tahoe_menu.h	2026-10-13 09:09:01.420581454 +0200
@@ -0,0 +1,34 @@
+/*
+ * AquaDesktop — macOS Tahoe menu metrics for Kvantum (patch 0003).
+ *
+ * Kvantum ties a menu's inner padding to its frame size, which is also its
+ * corner radius, and floors every item at Qt's font height + 8. macOS Tahoe
+ * menus have 13 px of padding above and below the items and 24 px rows.
+ *
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#ifndef TAHOE_MENU_H
+#define TAHOE_MENU_H
+
+#include <QComboBox>
+#include <QMenu>
+#include <QWidget>
+
+namespace Tahoe {
+
+// Extra vertical padding of a QMenu, on top of its frame (9 px in the
+// theme): 13 px in all, as macOS. Not for combo popups.
+inline int menuExtraVMargin(const QWidget *widget)
+{
+    return qobject_cast<const QMenu *>(widget) ? 4 : 0;
+}
+
+// A menu item's height over its font height: 24 px rows with a 17 px font.
+inline int menuItemPadding()
+{
+    return 7;
+}
+
+} // namespace Tahoe
+
+#endif
