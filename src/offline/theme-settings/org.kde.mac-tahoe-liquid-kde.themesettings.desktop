[Desktop Entry]
Type=Application
Name=Theme Settings
Name[es]=Ajustes del tema
Name[fr]=Réglages du thème
Name[zh_CN]=主题设置
GenericName=AquaDesktop
Comment=Appearance, accent colour, Liquid Glass or Frosted, and app icons
Comment[es]=Apariencia, color de acento, Liquid Glass o esmerilado, e iconos de apps
Comment[fr]=Apparence, couleur d'accentuation, Liquid Glass ou Givré, et icônes des apps
Comment[zh_CN]=外观、强调色、液态玻璃或磨砂，以及应用图标
Icon=preferences-desktop-theme-global
Exec=mac-tahoe-theme-settings
Terminal=false
Categories=Settings;DesktopSettings;GTK;
Keywords=theme;appearance;dark;light;accent;glass;frosted;blur;icon;icns;macos;
StartupNotify=true
Actions=Icons;

[Desktop Action Icons]
Name=Icons
Name[es]=Iconos
Name[fr]=Icônes
Name[zh_CN]=图标
Exec=mac-tahoe-theme-settings --page icons
